## ---------------------------------------------------------------------------
## Copy this file to `.env` and fill in your own values.
##   cp .env.example .env
## `.env` is gitignored, so it never leaves your machine.
## ---------------------------------------------------------------------------

## OpenRouter / OpenAI API key (OpenRouter key when base_url points to openrouter.ai)
OPENAI_API_KEY=

## Pipeline paths (machine-specific — set these for each machine).
## A leading ~ is expanded to your home directory.
# Where raw voice-memo recordings (.m4a) live
VOICE_MEMO_DIR=~/gdrive/Inbox/voice-memo-recordings
# Where transcripts are written by /voice-memo-process
RAW_TRANSCRIPT_DIR=~/Documents/voice-memo-agent-skills/raw-transcript
# Obsidian vault where /refine-memo-for-obsidian saves refined notes
OBSIDIAN_VAULT_DIR=~/Documents/mdNote/Voice-Memo-Vault
# Folder holding the canonical tag list (tag-list.md)
NOTE_PROPERTY_DIR=~/Documents/voice-memo-agent-skills/note-property

## Optional. Overrides `model.prompt` in config.yaml wholesale (it replaces the
## string, it does not append to it — so keep the Traditional-Chinese clause).
## Use it to add a proper-noun vocabulary: recurring names the model keeps
## mishearing. Those are real people, which is why they belong in gitignored
## .env and not in config.yaml. Add a name only once you have confirmed its
## spelling — a wrong name here teaches the model to snap a correct reading
## onto it. Leave unset to use the config.yaml default.
# TRANSCRIBE_SKILL_PROMPT="Output in Traditional Chinese (Taiwan, 繁體中文) only — never Simplified Chinese. Add appropriate punctuation. Transcribe verbatim: do not summarise, omit, or rephrase. These proper nouns recur in this speaker's memos — prefer these exact forms when you hear them: 名字一、名字二。"
